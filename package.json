{
  "name": "appear-on-scroll",
  "version": "2.0.0",
  "description": "Reveal elements as they enter the viewport, with a scroll-direction-aware slide. IntersectionObserver-based, zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2018 --clean",
    "typecheck": "tsc",
    "test": "npm run build && node test/run.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"demo/**/*.html\"",
    "build:docs": "npm run build && node scripts/build-docs.mjs",
    "demo:gif": "node scripts/record-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davemaynard/appear-on-scroll.git"
  },
  "keywords": [
    "appear",
    "reveal",
    "scroll",
    "intersection-observer",
    "animation",
    "fade",
    "slide",
    "scroll-direction",
    "viewport",
    "on-scroll"
  ],
  "author": "Dave Maynard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davemaynard/appear-on-scroll/issues"
  },
  "homepage": "https://davemaynard.github.io/appear-on-scroll",
  "devDependencies": {
    "playwright": "^1.48.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
